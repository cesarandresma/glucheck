# Ruta al JSON de cuenta de servicio de Firebase (NO subir al repositorio)
FIREBASE_CREDENTIALS_PATH=./serviceAccount.json

# Proveedor de IA (opcional). Si está vacío, el servidor devuelve un resumen estadístico local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Límite de solicitudes por minuto por UID (aproximado, en memoria)
RATE_LIMIT_PER_MINUTE=20

# ID del proyecto Firebase
FIREBASE_PROJECT_ID=your-project-id
