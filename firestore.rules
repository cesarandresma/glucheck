rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function validReadingData(data) {
      return data.keys().hasOnly([
          'userId', 'valueMgDl', 'measuredAt', 'context', 'notes',
          'createdAt', 'updatedAt', 'source', 'isDemo'
        ])
        && data.userId is string
        && data.userId.size() > 0
        && data.userId.size() <= 128
        && data.valueMgDl is number
        && data.valueMgDl >= 20
        && data.valueMgDl <= 600
        && data.measuredAt is int
        && data.context is string
        && data.context in ['en_ayunas', 'antes_comer', 'despues_comer', 'antes_dormir', 'otro']
        && data.createdAt is int
        && data.updatedAt is int
        && data.updatedAt >= data.createdAt
        && data.source is string
        && data.source in ['manual', 'imported', 'device']
        && data.isDemo is bool
        && (data.notes == null || (data.notes is string && data.notes.size() <= 500));
    }

    function validProfileData(data) {
      return data.keys().hasOnly([
          'displayName', 'email', 'createdAt', 'updatedAt'
        ])
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 80
        && data.email is string
        && data.email.size() > 3
        && data.email.size() <= 320
        && data.email == request.auth.token.email
        && data.createdAt is int
        && data.updatedAt is int
        && data.updatedAt >= data.createdAt;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validProfileData(request.resource.data);
      allow update: if isOwner(userId)
        && validProfileData(request.resource.data)
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(userId);

      match /readings/{readingId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && request.resource.data.userId == userId
          && validReadingData(request.resource.data);

        allow update: if isOwner(userId)
          && resource.data.userId == userId
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.isDemo == resource.data.isDemo
          && request.resource.data.source == resource.data.source
          && validReadingData(request.resource.data);

        allow delete: if isOwner(userId)
          && resource.data.userId == userId;
      }
    }
  }
}
